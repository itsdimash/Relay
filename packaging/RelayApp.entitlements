<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app itself (not the engine) listens to the microphone for voice notes. The hardened runtime
	     blocks that unless it is allowed here. Speech recognition needs no entitlement. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
